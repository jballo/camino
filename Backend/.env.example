DATABASE_URL=postgresql://agent:localdev@localhost:5432/onboarding_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_AGENT_ASK_REQUESTS=20
RATE_LIMIT_AGENT_ASK_WINDOW_SECONDS=600
RATE_LIMIT_REPOSITORY_INGEST_REQUESTS=2
RATE_LIMIT_REPOSITORY_INGEST_WINDOW_SECONDS=3600
RATE_LIMIT_REPOSITORY_SEARCH_REQUESTS=60
RATE_LIMIT_REPOSITORY_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_JOURNEY_CREATE_REQUESTS=5
RATE_LIMIT_JOURNEY_CREATE_WINDOW_SECONDS=3600

RUN_WORKER=true
WORKER_POLL_INTERVAL=1.5
WORKER_LEASE_TIMEOUT=1800
WORKER_MAX_ATTEMPTS=3

CLERK_SECRET_KEY=
CLERK_WH_KEY=
CLERK_JWT_KEY=

GH_APP_ID=
GH_APP_CLIENT_ID=
GH_APP_SECRET=
GH_APP_PRIVATE_KEY=
GH_WEBHOOK_SECRET=

ENCRYPTION_KEY=
